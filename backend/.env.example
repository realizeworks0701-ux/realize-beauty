APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30

# --- Googleカレンダー同期（フェーズ3。ADR-025） ---
# Google Cloud Console の OAuth クライアント（種類: ウェブアプリケーション）。
# 承認済みリダイレクトURI には {APP_URL}/api/v1/google-calendar/callback を登録する。
# APP_URL が API の公開URLとずれると OAuth と push 通知の両方が壊れるため注意。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SPA（Cloudflare Pages）のURL。OAuth コールバック後のリダイレクト先に使う。
# API とは別オリジンのため必須（未指定時は APP_URL にフォールバック）。
FRONTEND_URL=http://localhost:5173

# --- 本番デプロイ（Render / Cloudflare Pages / R2） ---
# フロント（Cloudflare Pages）のURLをカンマ区切りで指定。未指定は * （全許可）。
CORS_ALLOWED_ORIGINS=

# 写真ストレージ。本番は r2 を推奨（ADR-005）。ローカルは public のまま。
# FILESYSTEM_DISK=r2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=

VITE_APP_NAME="${APP_NAME}"
